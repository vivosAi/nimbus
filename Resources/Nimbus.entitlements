<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Accessibility API is incompatible with App Sandbox for this use,
	     so this app is deliberately unsandboxed and not App Store bound (§12). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
